# ==================== DATABASE ====================
DATABASE_URL="postgresql://user:pass@host/db"
# Neon: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/db?sslmode=require
# Local: postgresql://postgres:postgres@localhost:5432/greatphones

# DIRECT_URL is optional — Neon uses it for direct (non-pooled) connections
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ==================== NEXT.JS ====================
NEXTAUTH_URL="https://greatphones.com.ar"  # or http://localhost:3000 for dev
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# ==================== MERCADO PAGO ====================
MP_ACCESS_TOKEN="TEST-xxxxx"  # production: APP_USR-xxxxx
MP_WEBHOOK_SECRET=""  # set in MercadoPago webhook dashboard too

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=""  # Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=""  # Google Cloud Console → OAuth 2.0 Client Secret

# ==================== EMAIL (Nodemailer) ====================
EMAIL_USER="tucorreo@gmail.com"
EMAIL_PASS=""  # Gmail app password (activá 2FA → Contraseñas de aplicación)

# ==================== CLOUDINARY ====================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# ==================== SHIPPING ====================
# EnvioPack
ENVIOPACK_API_KEY=""   # optional — cotiza con estimados si no está configurado
ENVIOPACK_SECRET_KEY="" # optional — crear envío real requiere ambas keys

# Andreani
ANDREANI_API_URL="https://api.andreani.com"
ANDREANI_CONTRATO=""  # optional
ANDREANI_CUIT=""      # optional

# Correo Argentino (PAQ.AR MiCorreo)
# Credenciales de cliente corporativo. Sin configurar, cotiza con costos estimados.
CORREO_ARGENTINO_USER=""
CORREO_ARGENTINO_PASS=""
CORREO_ARGENTINO_CUSTOMER_ID=""
CORREO_ARGENTINO_TEST="false"  # true para apitest.correoargentino.com.ar

# ==================== RESEND (alternative email) ====================
RESEND_API_KEY=""

# ==================== REDIS (optional — enables presence sharing, email queues) ====================
REDIS_URL="redis://default:gQAAAAAAAwxyAAIgcDI0NjEyMjUyYTc5Zjc0MTg1ODhiNGYzYTRkMzA1YWQxOA@whole-fowl-199794.upstash.io:6379"  # Render Redis, Upstash, or local

# ==================== OPTIONAL ====================
# OPENAI_API_KEY=""       # AI-powered conversations
# CLOUDFLARE_ACCOUNT_ID=""  # R2 or Image optimization
# CLOUDFLARE_ACCESS_KEY_ID=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""

# ==================== ARCA (Facturación Electrónica) ====================
# CUIT del emisor (sin guiones)
ARCA_CUIT=""
# Contenido PEM del certificado X.509. Usar \n para saltos de línea:
# ARCA_CERT="-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----"
ARCA_CERT=""
# Contenido PEM de la clave privada:
# ARCA_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
ARCA_KEY=""
# true = producción / false u omitir = homologación (testing)
ARCA_PRODUCTION="false"
# Punto de venta habilitado en ARCA
ARCA_PTO_VTA="1"

# ==================== Sincronización con el sheet ERP ("PRUEBA GP") ====================
# URL /exec del Apps Script Web App desplegado desde sheet_sync_receiver.gs
# (repo saminglera6-source/excel). Si se deja vacío, las operaciones se
# encolan en SheetSync pero no se mandan — se pueden reintentar apenas se
# configure (ver panel: Gestión → Sincronización ERP).
ERP_SHEET_WEBHOOK_URL=""
# Debe coincidir con la propiedad ERP_SYNC_SECRET del Apps Script.
ERP_SHEET_SECRET=""
