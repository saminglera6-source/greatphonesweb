// ============================================================
//  ERP — NÚCLEO CONTABLE (Fase 1)
//  Adaptación del libro diario + caja por medio del ERP (Sheets)
// ============================================================

// Operadores del local (sin login) — lista fija del ERP.
model Operator {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Asiento contable: todo movimiento de valor del negocio.
enum AccountingType {
  INGRESO
  EGRESO
  NEUTRO
}

enum PaymentMeans {
  EFECTIVO
  TRANSFERENCIA
  CUOTAS
  USD
  PAGO_ONLINE
}

model AccountingEntry {
  id          String         @id @default(cuid())
  source      String         // módulo: SALE, PREORDER, PURCHASE, GASTO, CAMBIO, AJUSTE, ONLINE, ...
  operationId String?        // número de operación vinculada (VTA-xxx, CMP-xxx, PRE-xxx, GST-xxx...)
  description String
  category    String?
  type        AccountingType @default(INGRESO)
  means       PaymentMeans   @default(EFECTIVO)
  amount      Int            // en pesos (USD se guarda como dólares reales en amountUsd)
  amountUsd   Float?
  createdAt   DateTime       @default(now())
  opDate      DateTime       @default(now())
  operator    String?
  createdById String?
  metadata    Json?
  // Anulación: nunca se borra un asiento. Al anular una operación sus asientos
  // pasan a ANULADO y se emite un asiento espejo de reversión (reversalOf apunta
  // al operationId original). Caja/Reportes solo suman los ACTIVO.
  status      String         @default("ACTIVO") // ACTIVO | ANULADO | REVERSION
  reversalOf  String?        // operationId de la operación que este asiento revierte
  voidedAt    DateTime?
  voidReason  String?
  voidedBy    String?

  @@index([means])
  @@index([type])
  @@index([source])
  @@index([opDate])
  @@index([status])
  @@index([operationId])
}

// Saldo de caja por medio de pago (pesos y dólares separados, "nunca se mezclan").
model CashRegister {
  id         String      @id @default(cuid())
  means      PaymentMeans @unique
  balance    Int         @default(0)  // saldo en pesos
  balanceUsd Float?      @default(0)  // saldo en dólares (solo medio USD)
  updatedAt  DateTime    @updatedAt
}

// ============================================================
//  ERP — INTEGRIDAD Y GOBIERNO (Fase 3)
//  Auditoría genérica: sirve de auditoría + snapshot + registro
//  de anulaciones en una sola tabla. "Nunca se borra información".
// ============================================================

enum AuditAction {
  ANULACION
  RESTAURACION
  CORRECCION
  CREACION
  UPDATE
}

// Una entidad anulada se marca con `deletedAt` (nunca se borra físicamente).
// AuditLog conserva el snapshot completo previo al cambio + responsable + motivo.
model AuditLog {
  id          String      @id @default(cuid())
  entityType  String      // Product, Order, Repair, Quote, Accessory, PreOrder, ...
  entityId    String
  action      AuditAction @default(ANULACION)
  reason      String?
  operator    String?     // operador del ERP que ejecutó
  createdById String?
  snapshot    Json?       // foto del registro completo previo a la acción
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// Reprogramación de fecha en el Calendario de pendientes: permite mover un
// pendiente (reparación, preventa, pedido, cotización o arrepentimiento) a
// otro día sin tocar su fecha "real" de origen (createdAt, entrega, etc).
model CalendarOverride {
  id         String   @id @default(cuid())
  entityType String   // Reparaciones | Preventas | Pedidos | Cotizaciones | Arrepentimientos
  entityId   String
  date       DateTime
  operator   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([date])
}

// ============================================================
//  ERP — TESORERÍA / INVERSORES (Fase 4)
//  Cuenta corriente de financistas externos: capital invertido,
//  retiros (con tope), pago de rendimiento mensual (20%).
// ============================================================

model Investor {
  id          String             @id @default(cuid())
  name        String             @unique
  capital     Int                @default(0)  // capital invertido actual
  paidTotal   Int                @default(0)  // acumulado de rendimiento pagado
  pending     Int                @default(0)  // rendimiento pendiente de pago
  yieldRate   Int                @default(20) // % mensual
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  movements   InvestorMovement[]
  yields      InvestorYield[]
}

// Rendimiento mensual devengado (ERP §3.17: "tabla de rendimientos mensuales").
// Se genera con la acción `yield`; se marca PAGADO (FIFO) cuando se registra un
// movimiento PAGO_RENDIMIENTO.
model InvestorYield {
  id          String   @id @default(cuid())
  investorId  String
  period      String   // YYYY-MM
  capitalBase Int      // capital sobre el que se calculó
  amount      Int      // rendimiento calculado
  status      String   @default("PENDIENTE") // PENDIENTE | PAGADO
  paidAt      DateTime?
  operator    String?
  createdAt   DateTime @default(now())
  investor    Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, period])
  @@index([investorId])
  @@index([status])
}

enum InvestorMovementType {
  INGRESO_CAPITAL
  RETIRO_CAPITAL
  PAGO_RENDIMIENTO
  AJUSTE
}

model InvestorMovement {
  id          String               @id @default(cuid())
  investorId  String
  type        InvestorMovementType
  amount      Int                  // en pesos
  detail      String?
  capitalAfter Int                 @default(0)
  operator    String?
  createdById String?
  createdAt   DateTime             @default(now())
  investor    Investor             @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([createdAt])
}

// ============================================================
//  ERP — CONFIGURACIONES (Fase 5: regalos / reutilizable en Fase 7)
//  Clave-valor genérico para parámetros de negocio editables.
//  value es JSON.
// ============================================================

model AppConfig {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Feriados para el cálculo de días hábiles (plazo de entrega de preventas).
// Equivale a CONFIG_FERIADOS del ERP. Editable desde el panel.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  label     String?
  createdAt DateTime @default(now())

  @@index([date])
}

// Health Check (ERP §4.26): resultado de cada corrida de verificación de
// consistencia. Nunca se borra — permite ver la evolución de la salud del
// sistema en el tiempo. `findings` es un array JSON de hallazgos.
model HealthCheck {
  id        String   @id @default(cuid())
  runAt     DateTime @default(now())
  status    String   // OK | WARNING | ERROR | CRITICAL
  info      Int      @default(0)
  warning   Int      @default(0)
  error     Int      @default(0)
  critical  Int      @default(0)
  findings  Json     @default("[]")
  auto      Boolean  @default(false) // true si lo corrió el cron

  @@index([runAt])
}

// ============================================================
//  ERP — PRECIOS (Lista de Precios / Mac-iPad / Toma / Cuotas)
//  Portados desde el ERP (Google Sheets) a Prisma, editables sin
//  tocar código desde el panel admin. Los valores en USD se calculan
//  en vivo con dolarapi, no se guardan acá.
// ============================================================

model PriceList {
  id            String       @id @default(cuid())
  category      PriceCategory // 'CELULAR' | 'MACIPAD'
  modelo        String
  almacenamiento String
  precioARS     Int          @default(0)
  preventaARS   Int          @default(0)
  descuentoARS  Int          @default(0)
  imageUrl      String?
  colors        String[]     @default([])
  orden         Int          @default(0)
  active        Boolean      @default(true)
  updatedBy     String?
  updatedAt     DateTime     @updatedAt
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?

  @@index([category])
  @@index([modelo])
}

model PriceTradeIn {
  id        String @id @default(cuid())
  modelo    String
  impecable Int    @default(0)
  bateria   Int    @default(0)
  pantalla  Int    @default(0)
  camara    Int    @default(0)
  microfono Int    @default(0)
  parlante  Int    @default(0)
  tapa      Int    @default(0)
  marco     Int    @default(0)
  pin       Int    @default(0)
  orden     Int    @default(0)
  active    Boolean @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  deletedAt DateTime?
  deletedBy String?
  deleteReason String?

  @@index([modelo])
}

model CuotasConfig {
  id          String @id @default(cuid())
  cuotas      Int    @unique
  coeficiente Float
  activo      Boolean @default(true)
  mostrar     Boolean @default(true)
  observacion String?
  orden       Int    @default(0)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  deletedBy   String?
  deleteReason String?
}

enum PriceCategory {
  CELULAR
  MACIPAD
}

// ============================================================
//  ERP — TALLER: CONFIGURACIÓN DE REPARACIONES
//  Multiplicador y horas estimadas por categoría de trabajo
//  (equivalentes a CONFIG_REPARACIONES del ERP). Editable sin
//  tocar código desde el panel admin.
// ============================================================

model RepairConfig {
  id           String @id @default(cuid())
  key          String // bateria, pantalla, camara, microfono, parlante, tapa, marco, pin, flex, botones, chasis
  multiplicador Float  @default(1)
  horas        Int    @default(48)
  activo       Boolean @default(true)
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([key])
}

// Tarifario de un proveedor externo de repuestos (Icare). Se importa por CSV
// y reemplaza todo el contenido. El presupuesto de reparación lo consulta
// primero, antes de la fórmula propia (ERP §6.13).
model IcareTariff {
  id           String   @id @default(cuid())
  modelo       String
  categoria    String   // clave del trabajo: pantalla, bateria, ...
  modeloNorm   String   // modelo normalizado (minúsculas, sin almacenamiento) para el match en cascada
  precioGuia   Int      @default(0)
  precioPublico Int     @default(0) // precioGuia * 1.20 redondeado
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([modeloNorm, categoria])
  @@index([modelo])
}

// Compra de accesorios (multilínea). Cada línea es una fila con el mismo
// número de compra. Alimenta el stock y el costo promedio ponderado del SKU.
model AccessoryPurchase {
  id          String   @id @default(cuid())
  code        String                 // CAC-nnnn (compartido por las líneas de una compra)
  proveedor   String?
  accessoryId String
  categoria   String?
  producto    String
  cantidad    Int
  costoUnit   Int
  precioVenta Int?
  operator    String?
  createdById String?
  createdAt   DateTime @default(now())
  accessory   Accessory @relation(fields: [accessoryId], references: [id])

  @@index([code])
  @@index([accessoryId])
}
