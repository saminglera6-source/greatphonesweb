generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String
  password              String?
  phone                 String?
  dni                   String?
  provincia             String?
  ciudad                String?
  role                  Role              @default(CLIENT)
  avatar                String?
  location              String?
  verified              Boolean           @default(false)
  // Baja lógica: un usuario con operaciones no se borra, se desactiva.
  active                Boolean           @default(true)
  deactivatedAt         DateTime?
  deactivatedReason     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  cp                    String?
  direccion             String?
  piso                  String?
  accounts              Account[]
  arrepentimientos      Arrepentimiento[]
  cart                  Cart?
  adminConversations    Conversation[]    @relation("AdminConversations")
  conversations         Conversation[]
  coupons               Coupon[]
  favorites             Favorite[]
  redeemedGiftCards     GiftCard[]
  guarantees            Guarantee[]
  createdInventoryItems InventoryItem[]   @relation("CreatedBy")
  soldInventoryItems    InventoryItem[]   @relation("SoldBy")
  sentMessages          Message[]
  adminSales            Order[]           @relation("AdminSales")
  orders                Order[]
  preOrders             PreOrder[]
  quotes                Quote[]
  purchasedDevices      PurchasedDevice[]
  repairs               Repair[]
  sales                 Sale[]
  sessions              Session[]
  wallet                Wallet?
}

model Product {
  id             String          @id @default(cuid())
  name           String
  ico            String
  imageUrl       String?
  images         String[]
  brand          String
  sub            String?
  condition      String
  price          Int
  cost           Int
  battery        Int?
  stock          Int
  score          Int?
  color          String?
  screen         Float?
  type           String
  imei           String?
  sold           Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  slug           String?
  supplierId     String?
  discount       Int             @default(0)
  isOffer        Boolean         @default(false)
  offerEnd       DateTime?
  offerStart     DateTime?
  ram            String?
  storage        String?
  description    String?
  processor      String?
  reserved       Int             @default(0)
  modelGroup     String?
  isPreorder     Boolean         @default(false)
  availableFrom  DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  deleteReason   String?
  cartItems      CartItem[]
  favorites      Favorite[]
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  preOrders      PreOrder[]
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
}

model ProductLog {
  id        String   @id @default(cuid())
  productId String?
  name      String
  brand     String
  price     Int
  cost      Int      @default(0)
  stock     Int
  discount  Int      @default(0)
  condition String
  type      String
  color     String?
  storage   String?
  ram       String?
  battery   Int?
  imei      String?
  source    String
  createdAt DateTime @default(now())
}

model InventoryItem {
  id                  String             @id @default(cuid())
  code                String             @unique
  imei                String             @unique
  serialNumber        String?
  brand               String
  modelName           String
  storage             String?
  color               String?
  modelNumber         String?
  deviceType          String
  specs               Json?
  imageUrl            String?
  purchasePrice       Int
  cosmeticCondition   String
  functionalCondition String?
  batteryHealth       Int?
  notes               String?
  repairCost          Int?
  investor            String?
  targetPrice         Int?
  status              InventoryStatus    @default(IN_STOCK)
  qrCode              String?
  labelPrinted        Boolean            @default(false)
  productId           String?
  supplierId          String?
  purchasedFrom       String?
  purchaseDate        DateTime           @default(now())
  salePrice           Int?
  soldAt              DateTime?
  soldById            String?
  createdById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  history             InventoryHistory[]
  preOrder            PreOrder?
  createdBy           User               @relation("CreatedBy", fields: [createdById], references: [id])
  product             Product?           @relation(fields: [productId], references: [id])
  soldBy              User?              @relation("SoldBy", fields: [soldById], references: [id])
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  orderItems          OrderItem[]
}

model InventoryHistory {
  id              String        @id @default(cuid())
  inventoryItemId String
  type            String
  oldValue        String?
  newValue        String?
  description     String?
  userId          String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model TacCache {
  id          String   @id @default(cuid())
  tac         String   @unique
  brand       String
  modelName   String
  storage     String?
  color       String?
  modelNumber String?
  deviceType  String   @default("celular")
  imageUrl    String?
  specs       Json?
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                  String               @id @default(cuid())
  code                String               @unique
  userId              String
  status              OrderStatus          @default(PENDING)
  warranty            String?
  cuotas              Int                  @default(1)
  payment             String?
  subtotal            Int
  total               Int
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  clientDni           String?
  clientEmail         String?
  clientName          String?
  clientPhone         String?
  mpPaymentId         String?
  mpPreferenceId      String?
  mpStatus            String?
  shippingCity        String?
  shippingFloor       String?
  shippingNumber      String?
  shippingProvince    String?
  shippingStreet      String?
  shippingZip         String?
  deliveryCost        Int                  @default(0)
  warrantyCost        Int                  @default(0)
  arrepReason         String?
  arrepStatus         String?
  refundDate          DateTime?
  refundProcessed     Boolean              @default(false)
  shippedAt           DateTime?
  trackingNumber      String?
  adminId             String?
  cashReceived        Int?
  change              Int?
  saleChannel         String               @default("online")
  clientAddress       String?
  clientCuil          String?
  currency            String               @default("ARS")
  carrier             String?
  carrierService      String?
  enviopackId         String?
  trackingUrl         String?
  deletedAt           DateTime?
  deletedBy           String?
  deleteReason        String?
  arrepentimientos    Arrepentimiento[]
  invoice             Invoice?
  admin               User?                @relation("AdminSales", fields: [adminId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  orderCoupons        OrderCoupon[]
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]
  warrantyExtends     WarrantyExtend[]
  preOrders           PreOrder[]
  @@index([userId])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  productId       String?
  quantity        Int            @default(1)
  price           Int
  customName      String?
  customPrice     Int?
  accessoryId     String?
  inventoryItemId String?
  accessory       Accessory?     @relation(fields: [accessoryId], references: [id])
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id])
}

model PreOrder {
  id                    String    @id @default(cuid())
  code                  String    @unique
  clientName            String
  clientDni             String?
  clientPhone           String?
  clientEmail           String?
  productId             String?
  customName            String?
  customPrice           Int?
  notes                 String?
  // Valores canónicos (Fase 1 ciclo de preventa): ESPERANDO_COMPRA | COMPRADO |
  // ENTREGADO_SALDO | ENTREGADO | CANCELADO. El servicio lib/preventas.ts es la
  // única fuente de escritura; se mantiene como String por compat. con datos
  // históricos (PENDING/PAID/CONFIRMED/DELIVERED) que se normalizan al leer.
  status                String    @default("ESPERANDO_COMPRA")
  // Cobro acumulado de la preventa (seña + entregas parciales). ARS en pesos;
  // collectedUsd en cantidad de dólares reales. El saldo a cobrar en la entrega
  // es price - collectedArs - round(collectedUsd * cotización).
  collectedArs          Int       @default(0)
  collectedUsd          Float     @default(0)
  // Vendedor comercial que tomó la preventa (distinto del operador que la cargó).
  sellerName            String?
  // Código de la Venta (Sale) generada al entregar — se reutiliza en entregas
  // parciales sucesivas para no duplicarla.
  saleCode              String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deliveredAt           DateTime?
  expectedDeliveryEnd   DateTime?
  expectedDeliveryStart DateTime?
  installments          Int?
  paymentMethod         String?
  paymentType           String?
  price                 Int       @default(0)
  productColor          String?
  productCondition      String?
  productModelName      String?
  productStorage        String?
  source                String    @default("local")
  agreedToTerms         Boolean   @default(false)
  userId                String?
  orderId               String?
  mpPaymentId           String?
  mpPreferenceId        String?
  inventoryItemId       String?           @unique
  deletedAt             DateTime?
  deletedBy             String?
  deleteReason          String?
  product               Product?  @relation(fields: [productId], references: [id])
  user                  User?     @relation(fields: [userId], references: [id])
  order                 Order?    @relation(fields: [orderId], references: [id])
  inventoryItem         InventoryItem?    @relation(fields: [inventoryItemId], references: [id])
}

model Quote {
  id              String          @id @default(cuid())
  code            String          @unique
  userId          String
  device          String
  storage         String
  condition       String
  basePrice       Int
  finalPrice      Int
  bonus           Int?
  status          QuoteStatus     @default(PENDING)
  envio           String?
  payment         String?
  clientName      String?
  clientDni       String?
  clientPhone     String?
  clientCity      String?
  signature       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  extras          String[]
  photos          String[]
  rejectReason    String?
  clientCp        String?
  clientProvince  String?
  dniPhotos       String[]
  batteryHealth   Int?
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  invoice         Invoice?
  purchasedDevice PurchasedDevice?
  user            User            @relation(fields: [userId], references: [id])
}

model PurchasedDevice {
  id              String   @id @default(cuid())
  code            String   @unique
  quoteId         String   @unique
  brand           String
  device          String
  storage         String
  condition       String
  color           String?
  batteryHealth   Int?
  imei            String?
  serialNumber    String?
  clientName      String
  clientDni       String?
  clientPhone     String?
  clientCity      String?
  clientProvince  String?
  purchasePrice   Int
  invoiceId       String?  @unique
  receivedAt      DateTime @default(now())
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy       User     @relation(fields: [createdById], references: [id])
}

model Sale {
  id        String     @id @default(cuid())
  code      String     @unique
  userId    String
  device    String
  storage   String?
  condition String?
  imei      String?
  price     Int
  cost      Int        @default(0)
  profitReal Int       @default(0)
  originType String?   // propio / consignacion
  payment   String
  status    SaleStatus @default(PENDING)
  operator  String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
}

model Repair {
  id          String        @id @default(cuid())
  code        String        @unique
  userId      String
  device      String
  issue       String
  serviceId   String?
  price       Int?
  status      RepairStatus  @default(PENDING)
  // === Fase 5 ERP: ciclo completo de reparación ===
  type        String?       // particular / garantia / preventa / interno
  clientName  String?
  clientPhone String?
  clientDni   String?
  imei        String?
  pin         String?
  fault1      String?
  fault2      String?
  jobs        String[]      // trabajos: Batería, Pantalla, Cámara, ...
  diagnosis   String?
  diagnosisStatus String?   // PENDIENTE / ACEPTADO / RECHAZADO
  pricePaid   Int?          // precio cobrado (puede ser 0)
  priceCalc   Int?          // precio calculado por tarifario
  cost        Int           @default(0)      // costo interno de la reparación
  thirdPartyCost Int?                        // costo que cobra el tercero si THIRD_PARTY
  profitReal  Int?                           // ganancia: pricePaid - (thirdPartyCost o cost)
  estimatedHours Int?
  isDiagnosis Boolean       @default(false)
  deliveredAt DateTime?
  thirdParty  Boolean           @default(false)
  operator    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  deletedBy   String?
  deleteReason String?
  service     RepairService? @relation(fields: [serviceId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model RepairService {
  id          String   @id @default(cuid())
  name        String
  ico         String
  description String?
  price       Int
  category    String?
  repairs     Repair[]
}

model Guarantee {
  id        String          @id @default(cuid())
  userId    String
  product   String
  type      String
  price     Int?
  startsAt  DateTime        @default(now())
  expiresAt DateTime
  status    GuaranteeStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  type           String
  phone          String?
  email          String?
  notes          String?
  total          Int             @default(0)
  createdAt      DateTime        @default(now())
  inventoryItems InventoryItem[]
  products       Product[]
  accessories    Accessory[]
}

model Conversation {
  id            String         @id @default(cuid())
  userId        String
  type          ConvType
  subject       String?
  lastMsgAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  adminId       String?
  closedAt      DateTime?
  status        ConvStatus     @default(OPEN)
  unreadByAdmin Int            @default(0)
  unreadByUser  Int            @default(0)
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  admin         User?          @relation("AdminConversations", fields: [adminId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  messages      Message[]
  notifications Notification[]

  @@index([userId, lastMsgAt])
  @@index([adminId, lastMsgAt])
  @@index([status])
  @@index([lastMsgAt])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  from           String
  text           String?
  imageUrl       String?
  imageCaption   String?
  readAt         DateTime?
  createdAt      DateTime       @default(now())
  fromUserId     String?
  status         MsgStatus      @default(SENT)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUser       User?          @relation(fields: [fromUserId], references: [id])
  notifications  Notification[]

  @@index([conversationId, createdAt])
  @@index([fromUserId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  totalEarned  Int                 @default(0)
  totalSpent   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  version      Int                 @default(0)
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String          @id @default(cuid())
  walletId      String
  type          TransactionType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  giftCard      GiftCard?
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Coupon {
  id              String        @id @default(cuid())
  userId          String
  code            String        @unique
  originalAmount  Int
  remainingAmount Int
  status          CouponStatus  @default(ACTIVE)
  source          String?
  sourceId        String?
  countsToProfit  Boolean       @default(true)
  note            String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  usedAt          DateTime?
  user            User          @relation(fields: [userId], references: [id])
  orderCoupons    OrderCoupon[]

  @@index([userId])
  @@index([code])
  @@index([status])
}

model OrderCoupon {
  id         String   @id @default(cuid())
  orderId    String
  couponId   String
  amountUsed Int
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([couponId])
}

model GiftCard {
  id               String             @id @default(cuid())
  code             String             @unique
  originalAmount   Int
  remainingAmount  Int
  status           GiftCardStatus     @default(ACTIVE)
  buyerEmail       String?
  recipientEmail   String?
  message          String?
  mpPreferenceId   String?
  mpPaymentId      String?
  mpStatus         String?
  expiresAt        DateTime?
  purchasedAt      DateTime           @default(now())
  redeemedAt       DateTime?
  redeemedByUserId String?
  transactionId    String?            @unique
  version          Int                @default(0)
  redeemedBy       User?              @relation(fields: [redeemedByUserId], references: [id])
  transaction      WalletTransaction? @relation(fields: [transactionId], references: [id])

  @@index([code])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Notification {
  id             String        @id @default(cuid())
  userId         String?
  type           NotifType
  title          String
  text           String
  read           Boolean       @default(false)
  createdAt      DateTime      @default(now())
  conversationId String?
  messageId      String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  message        Message?      @relation(fields: [messageId], references: [id])

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model Accessory {
  id               String      @id @default(cuid())
  name             String
  ico              String?
  description      String?
  category         String
  price            Int
  cost             Int         @default(0)   // costo promedio ponderado histórico
  lastCost         Int         @default(0)   // costo de la compra más reciente
  stock            Int         @default(0)
  reserved         Int         @default(0)
  sold             Int         @default(0)
  createdAt        DateTime    @default(now())
  brand            String?
  color            String?
  compareAtPrice   Int?
  compatibleModels String?
  imageUrl         String?
  isActive         Boolean     @default(true)
  images           String[]    @default([])
  discount         Int?
  isOffer          Boolean     @default(false)
  offerEnd         DateTime?
  offerStart       DateTime?
  modelGroup       String?
  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  purchases        AccessoryPurchase[]

  @@index([category])
  @@index([brand])
  @@index([stock])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, code])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Arrepentimiento {
  id        String      @id @default(cuid())
  orderId   String
  userId    String?
  email     String
  telefono  String?
  motivo    String?
  estado    ArrepEstado @default(PENDIENTE)
  tramite   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  order     Order       @relation(fields: [orderId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model WarrantyExtend {
  id             String               @id @default(cuid())
  orderId        String
  imei           String
  plan           String
  months         Int
  price          Int
  status         WarrantyExtendStatus @default(PENDING_PAYMENT)
  startDate      DateTime             @default(now())
  endDate        DateTime
  createdAt      DateTime             @default(now())
  mpPaymentId    String?
  mpPreferenceId String?
  mpStatus       String?
  order          Order                @relation(fields: [orderId], references: [id])
}

model PaymentTransaction {
  id           String   @id @default(cuid())
  orderId      String
  amount       Int
  currency     String   @default("ARS")
  method       String
  status       String   @default("pending")
  mpPaymentId  String?
  mpStatus     String?
  installments Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([mpPaymentId])
}

model Invoice {
  id              String           @id @default(cuid())
  orderId         String?          @unique
  quoteId         String?          @unique
  type            String           @default("C")
  pos             Int              @default(1)
  number          Int
  cae             String?
  caeExpiry       DateTime?
  total           Int
  netAmount       Int
  ivaAmount       Int
  status          String           @default("PENDING")
  pdfUrl          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  purchasedDevice PurchasedDevice?
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id          String     @id @default(cuid())
  cartId      String
  productId   String?
  accessoryId String?
  quantity    Int        @default(1)
  createdAt   DateTime   @default(now())
  accessory   Accessory? @relation(fields: [accessoryId], references: [id])
  cart        Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id])

  @@index([cartId])
}

